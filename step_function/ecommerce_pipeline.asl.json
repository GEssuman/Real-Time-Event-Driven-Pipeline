{
  "Comment": "Validate S3 file, fetch result, and trigger Spark transformation",
  "StartAt": "Run Validator Task",
  "States": {
    "Run Validator Task": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:eu-north-1:309797288544:cluster/descriptive-eagle-oe8xc5",
        "TaskDefinition": "arn:aws:ecs:eu-north-1:309797288544:task-definition/etl-validation-task:1",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "etl-validator",
              "Environment": [
                {
                  "Name": "S3_FILE_PATH",
                  "Value": "s3://ecommerce-raw.amalitech-gke/orders/orders_part1.csv"
                },
                {
                  "Name": "FILE_TYPE",
                  "Value": "orders"
                },
                {
                  "Name": "EVENT_TIME",
                  "Value.$": "States.Format('{}', $.event_time)"
                }
              ]
            }
          ]
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-04852f4dd38926104"
            ],
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-04a5d550735d08aeb"
            ]
          }
        }
      },
      "ResultPath": "$.validatorTask",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Send Validator Error Notification"
        }
      ],
      "Next": "Fetch Validation Result"
    },
    "Fetch Validation Result": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "ecommerce-validitor-checks",
        "Key.$": "States.Format('validation-results/all/validation_summary_{}.json', $.event_time)"
      },
      "ResultSelector": {
        "Body.$": "States.StringToJson($.Body)"
      },
      "ResultPath": "$.validationOutput",
      "Next": "Check Validator Result"
    },
    "Check Validator Result": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validationOutput.Body.validated_status",
          "BooleanEquals": true,
          "Next": "Run Spark Transform Task"
        }
      ],
      "Default": "Send Validation Failure Notification"
    },
    "Run Spark Transform Task": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:eu-north-1:309797288544:cluster/descriptive-eagle-oe8xc5",
        "TaskDefinition": "arn:aws:ecs:eu-north-1:309797288544:task-definition/spark-transform-task:1",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "spark-tranform",
              "Environment": [
                {
                  "Name": "S3_FILE_PATH",
                  "Value": "s3://ecommerce-raw.amalitech-gke/orders/orders_part1.csv"
                },
                {
                  "Name": "FILE_TYPE",
                  "Value": "orders"
                },
                {
                  "Name": "EVENT_TIME",
                  "Value.$": "States.Format('{}', $.event_time)"
                }
              ]
            }
          ]
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-04852f4dd38926104"
            ],
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-04a5d550735d08aeb"
            ]
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Send Spark Failure Notification"
        }
      ],
      "End": true
    },
    "Send Validation Failure Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:eu-north-1:309797288544:ecommerce-etl-pipeline-alerts",
        "Message.$": "States.Format('Validation failed at event time {}. Check schema or data quality.', $.event_time)",
        "Subject": "ETL Pipeline Alert: Validation Failed"
      },
      "End": true
    },
    "Send Validator Error Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:eu-north-1:309797288544:ecommerce-etl-pipeline-alerts",
        "Message.$": "States.Format('Validator ECS task failed unexpectedly at event time {}.', $.event_time)",
        "Subject": "ETL Pipeline Alert: Validator Task Error"
      },
      "End": true
    },
    "Send Spark Failure Notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:eu-north-1:309797288544:ecommerce-etl-pipeline-alerts",
        "Message.$": "States.Format('Spark transformation failed for file: {} at event time {}.', $.S3_FILE_PATH, $.event_time)",
        "Subject": "ETL Pipeline Alert: Spark Task Failed"
      },
      "End": true
    }
  }
}